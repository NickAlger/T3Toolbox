digraph components {
  rankdir=LR; node [shape=box, fontname="Helvetica", fontsize=11];
  w [style=dashed]; y [style=dashed]; p [style=dashed];
  subgraph cluster_plain { label="Plain: changes with the point"; fontname="Helvetica"; fontsize=11;
    "xi";
    "mu";
    "nu";
    "eta";
    "z";
  }
  subgraph cluster_resid { label="Residual grade, seed r: changes with the point and the data"; fontname="Helvetica"; fontsize=11;
    "r";
    "f" [shape=ellipse];
    "xi_z";
    "mu_z";
    "nu_z";
    "eta_z";
    "g" [shape=ellipse];
  }
  subgraph cluster_tangent { label="Tangent grade: changes with the direction p"; fontname="Helvetica"; fontsize=11;
    "xi_t";
    "mu_t";
    "nu_t";
    "eta_t";
    "Jp";
  }
  subgraph cluster_gn { label="Residual grade, seed J p: changes with the direction p"; fontname="Helvetica"; fontsize=11;
    "Jp.xi_z";
    "Jp.mu_z";
    "Jp.nu_z";
    "Jp.eta_z";
    "Hp" [shape=ellipse];
  }
  "w" -> "xi" [style=dashed];
  "w" -> "xi_t" [style=dashed];
  "w" -> "g" [style=dashed];
  "w" -> "Hp" [style=dashed];
  "y" -> "r" [style=dashed];
  "p" -> "xi_t" [style=dashed];
  "p" -> "mu_t" [style=dashed];
  "p" -> "nu_t" [style=dashed];
  "p" -> "eta_t" [style=dashed];
  "p" -> "Jp" [style=dashed];
  "xi" -> "mu";
  "xi" -> "nu";
  "mu" -> "eta";
  "nu" -> "eta";
  "eta" -> "z";
  "z" -> "r";
  "r" -> "f";
  "r" -> "xi_z";
  "xi" -> "mu_z";
  "mu" -> "mu_z";
  "xi_z" -> "mu_z";
  "xi" -> "nu_z";
  "nu" -> "nu_z";
  "xi_z" -> "nu_z";
  "mu" -> "eta_z";
  "nu" -> "eta_z";
  "mu_z" -> "eta_z";
  "nu_z" -> "eta_z";
  "xi" -> "g";
  "mu" -> "g";
  "nu" -> "g";
  "eta" -> "g";
  "r" -> "g";
  "xi_z" -> "g";
  "mu_z" -> "g";
  "nu_z" -> "g";
  "eta_z" -> "g";
  "xi" -> "mu_t";
  "mu" -> "mu_t";
  "xi_t" -> "mu_t";
  "xi" -> "nu_t";
  "nu" -> "nu_t";
  "xi_t" -> "nu_t";
  "mu" -> "eta_t";
  "nu" -> "eta_t";
  "mu_t" -> "eta_t";
  "nu_t" -> "eta_t";
  "eta" -> "Jp";
  "eta_t" -> "Jp";
  "Jp" -> "Jp.xi_z";
  "xi" -> "Jp.mu_z";
  "mu" -> "Jp.mu_z";
  "Jp.xi_z" -> "Jp.mu_z";
  "xi" -> "Jp.nu_z";
  "nu" -> "Jp.nu_z";
  "Jp.xi_z" -> "Jp.nu_z";
  "mu" -> "Jp.eta_z";
  "nu" -> "Jp.eta_z";
  "Jp.mu_z" -> "Jp.eta_z";
  "Jp.nu_z" -> "Jp.eta_z";
  "xi" -> "Hp";
  "mu" -> "Hp";
  "nu" -> "Hp";
  "eta" -> "Hp";
  "Jp" -> "Hp";
  "Jp.xi_z" -> "Hp";
  "Jp.mu_z" -> "Hp";
  "Jp.nu_z" -> "Hp";
  "Jp.eta_z" -> "Hp";
}
